{
  "productName": "LiquidLauncher",
  "version": "0.6.1",
  "identifier": "net.ccbluex.liquidlauncher",
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "水影启动器",
        "label": "main",
        "width": 1000,
        "minWidth": 1000,
        "height": 670,
        "minHeight": 670,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "center": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ]
        },
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "copyright": "CCBlueX",
    "publisher": "CCBlueX",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "我的世界水影客户端启动器",
    "longDescription": "用于启动我的世界水影客户端（LiquidBounce）的启动器",
    "license": "GPL-3.0",
    "licenseFile": "../LICENSE",
    "resources": [],
    "targets": [
      "msi"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QkM5MTlDREQ4NkEzNjMKUldSam80YmRuSkc4NVNxS2MzYVZPN1I4a283RkdsS0lPTjVjRWlxQ1JhdzFZUkRtc0c1eEtqSzQK",
      "endpoints": [
        "https://github.com/CCBlueX/LiquidLauncher/releases/latest/download/latest.json",
        "https://api.liquidbounce.net/api/v1/launcher/releases/{{target}}/{{current_version}}"
      ]
    }
  }
}
